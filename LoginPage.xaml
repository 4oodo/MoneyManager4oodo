<Page x:Class="MoneyManager4oodo.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyManager4oodo"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Авторизация"
                       FontSize="24px"
                       Foreground="{StaticResource TextColor}"/>

            <TextBox Width="200px"
                     Height="30px"
                     Margin="10px"/>
            <PasswordBox Width="200px"
                     Height="30px"
                     Margin="10px"/>
            <Button Width="150px"
                    Height="40px"
                    Content="Войти"
                    FontSize="10px"
                    Margin="0 20px 0 0"
                    Background="{StaticResource ElementsColor}"
                    Foreground="{StaticResource SecondaryColor}" Click="Login_Button_Click"
                    />
            <TextBlock Text="Зарегистрироваться"
                       Foreground="{StaticResource TextColor}"
                       HorizontalAlignment="Center"
                       Margin="0 10px 0 0"
                       Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>
