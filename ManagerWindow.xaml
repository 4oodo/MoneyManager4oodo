<Window x:Class="MoneyManager4oodo.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MoneyManager4oodo"
        mc:Ignorable="d"
        Title="ManagerWindow" Height="450" Width="800"
        Background="{StaticResource PrimaryColor}"
        FontFamily="Consolas">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Background="{StaticResource ElementsColor}">
            <TextBlock
                Text="Меню"
                Foreground="{StaticResource SecondaryColor}"
                FontSize="24px"
                HorizontalAlignment="Center"
                Margin="0 10px 0 0"/>
            <Image Source="/Pictures/Home.png"
                   Style="{StaticResource ImageStyle}"/>
            <Image Source="/Pictures/Income.png"
                   Style="{StaticResource ImageStyle}"/>
            <Image Source="/Pictures/Spendings.png"
                   Style="{StaticResource ImageStyle}"/>
            <Image Source="/Pictures/AccountImage.png"
                   Style="{StaticResource ImageStyle}"/>
            <Image Source="/Pictures/Settings.png"
                   Style="{StaticResource ImageStyle}"/>
        </StackPanel>
        <Frame x:Name="ManegerFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
